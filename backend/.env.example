# Copie para .env e preencha antes de rodar em produção.
# Em desenvolvimento, o backend sobe sem este arquivo: config/db.js pula a
# conexão se MONGODB_URI faltar, e config/env.js usa um JWT_SECRET de dev
# claramente inseguro se JWT_SECRET faltar (nunca em produção).

PORT=5000

# String de conexão do MongoDB Atlas (ou de um mongod local). Vazio = o
# servidor sobe mesmo assim, mas toda rota que depende do banco responde 503.
MONGODB_URI=

# Segredo de assinatura do JWT de sessão. Gere um valor aleatório longo antes
# de ir para produção — nunca reaproveite o fallback de desenvolvimento.
JWT_SECRET=

# Origens aceitas pelo CORS (HTTP e Socket.IO). Aceita VÁRIAS separadas por
# vírgula — necessário porque cada deploy de preview da Vercel tem domínio
# próprio, e com uma origem só todos eles falhariam no CORS.
#   FRONTEND_ORIGIN=https://saas-ingles.vercel.app,https://saas-ingles-git-branch.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

NODE_ENV=development
